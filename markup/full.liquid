{% comment %}
  Deux URL de polling : IDX_0 = un personnage de manga, IDX_1 = un personnage de jeu vidéo, tirés au hasard à chaque rafraîchissement.
  L'option « Univers » choisit lequel afficher ; « Les deux » alterne selon l'heure (créneaux de 5 minutes).
{% endcomment %}
{% assign u = trmnl.plugin_settings.custom_fields_values.univers | default: "manga" | downcase %}
{% if u contains "mix" or u contains "deux" %}
  {% assign creneau = trmnl.system.timestamp_utc | divided_by: 300 | floor | modulo: 2 %}
  {% if creneau == 1 %}{% assign u = "jv" %}{% else %}{% assign u = "manga" %}{% endif %}
{% endif %}
{% if u contains "jv" or u contains "jeux" %}{% assign f = IDX_1 %}{% else %}{% assign f = IDX_0 %}{% endif %}

<div class="layout layout--row layout--stretch gap--large" style="align-items: stretch;">
  <div class="flex flex--col gap--small" style="flex: 1 1 0; min-width: 0; align-items: stretch; text-align: left;">
    <span class="title title--large" data-clamp="1" style="text-align: left;">{{ f.nom }}</span>
    {% if f.type == "jv" %}
      {% if f.alias != "" %}<span class="label label--small" data-clamp="1" style="text-align: left;">« {{ f.alias }} »</span>{% endif %}
    {% else %}
      {% if f.surnom != "" %}<span class="label label--small" data-clamp="1" style="text-align: left;">« {{ f.surnom }} »</span>{% endif %}
    {% endif %}
    <div class="divider"></div>

    <div style="display: grid; grid-template-columns: 34% 1fr; column-gap: 12px; row-gap: 5px; width: 100%; align-items: baseline;">
      {% if f.type == "jv" %}
        {% for l in f.lignes limit: 8 %}
        <span class="label" data-clamp="1">{{ l.label }}</span><span class="description" data-clamp="1">{{ l.valeur }}</span>
        {% endfor %}
      {% else %}
        <span class="label">MANGA</span><span class="description" data-clamp="1">{{ f.manga }}</span>
        <span class="label">AUTEUR</span><span class="description" data-clamp="1">{{ f.auteurs }}</span>
        <span class="label">RÔLE</span><span class="description">{{ f.role }}</span>
        <span class="label">FANS</span><span class="description">{{ f.fans }}</span>
        {% for s in f.stats limit: 4 %}
        <span class="label" data-clamp="1">{{ s.label | upcase }}</span><span class="description" data-clamp="1">{{ s.valeur }}</span>
        {% endfor %}
      {% endif %}
    </div>

    <div class="divider"></div>
    <span class="description" data-clamp="5" data-clamp-lg="9" style="text-align: left;">{{ f.resume }}</span>
    {% if f.type == "jv" and f.jeux_phares != "" %}
    <span class="label label--small" data-clamp="2" style="text-align: left;">JEUX PHARES · {{ f.jeux_phares }}</span>
    {% endif %}
  </div>

  <div class="flex flex--col flex--center" style="flex: 0 0 38%;">
    <img class="image image-dither image--contain" src="{{ f.image }}" style="width: 100%; height: 100%; object-fit: contain;">
  </div>
</div>

<div class="title_bar">
  <span class="title">{% if f.type == "jv" %}Scouter jeux vidéo{% else %}Scouter manga{% endif %}</span>
  <span class="instance">{{ f.total_personnages }} personnages</span>
</div>
